<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ApplicationLayer.ViewModels;assembly=ApplicationLayer"
             x:Class="PedidosCPE.Views.Productos.SearchProductosView">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Main">#F4F4F2</Color>
            <Color x:Key="Sub">#C89F69</Color>
            <Color x:Key="SubTier">#FEBC9C</Color>
            <Color x:Key="Tier">#14134F</Color>
            <Color x:Key="Black">#000</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.BindingContext>
        <vm:VMSearchProductos/>
    </ContentPage.BindingContext>

    <Grid Padding="20" BackgroundColor="{StaticResource Main}" RowDefinitions="Auto, Auto, Auto, *, Auto, Auto" ColumnDefinitions="3*, 1*">

        <Label Grid.Column="0" Grid.ColumnSpan="2"
               Text="Buscar y Seleccionar Productos"
               Style="{StaticResource LabelTitle}"
               Margin="0,10,0,20"
               TextColor="{StaticResource Black}"/>

        <Frame Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="0" HasShadow="True" BackgroundColor="{StaticResource Main}" CornerRadius="10" Margin="0,0,0,10">
            <StackLayout Orientation="Horizontal" Padding="10">
                <SearchBar x:Name="searchBar"
                           Placeholder="Buscar Producto..."
                           SearchButtonPressed="searchBar_SearchButtonPressed"
                           TextChanged="searchBar_TextChanged"
                           Style="{StaticResource SearchBar}"
                           Margin="0,0,10,0"
                           BackgroundColor="{StaticResource SubTier}"
                           PlaceholderColor="{StaticResource Tier}"
                           TextColor="{StaticResource Black}"/>
            </StackLayout>
        </Frame>

        <Frame Grid.Row="2" Grid.Column="0" BackgroundColor="{StaticResource Sub}" Margin="0,0,10,0" CornerRadius="10">
            <Grid ColumnDefinitions="*, *, *">
                <Label Text="Nombre" Grid.Column="0" Style="{StaticResource LabelTabla}" TextColor="{StaticResource Main}"/>
                <Label Text="Código" Grid.Column="1" Style="{StaticResource LabelTabla}" TextColor="{StaticResource Main}"/>
                <Label Text="Precio" Grid.Column="2" Style="{StaticResource LabelTabla}" TextColor="{StaticResource Main}"/>
            </Grid>
        </Frame>

        <CollectionView Grid.Row="3" Grid.Column="0"
                        x:Name="resultList"
                        ItemsSource="{Binding ProductosEncontrados}"
                        SelectionChanged="resultList_SelectionChanged"
                        SelectionMode="Single"
                        Margin="0,0,10,0"
                        BackgroundColor="{StaticResource Main}"
                        HeightRequest="300">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" BackgroundColor="{StaticResource Main}" Margin="0,0,0,10" CornerRadius="10" BorderColor="{StaticResource Sub}" HasShadow="True">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="{Binding CNOMBREPRODUCTO}"
                                   Style="{StaticResource LabelTabla}"
                                   HorizontalOptions="StartAndExpand"/>
                            <Label Text="{Binding CCODIGOPRODUCTO}"
                                   Style="{StaticResource LabelTabla}"
                                   HorizontalOptions="CenterAndExpand"
                                   TextColor="{StaticResource Sub}"/>
                            <Label Text="{Binding CPRECIO1}"
                                   Style="{StaticResource LabelTabla}"
                                   HorizontalOptions="End"
                                   TextColor="{StaticResource SubTier}"/>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView Grid.Row="3" Grid.Column="1"
                        x:Name="selectedList"
                        ItemsSource="{Binding ProductosSeleccionados}"
                        SelectionMode="Single"
                        SelectionChanged="selectedList_SelectionChanged"
                        BackgroundColor="{StaticResource Main}"
                        Margin="0,0,0,10"
                        HeightRequest="200">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" BackgroundColor="{StaticResource Main}" Margin="0,0,0,10" CornerRadius="10" BorderColor="{StaticResource Sub}" HasShadow="True">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="{Binding CNOMBREPRODUCTO}"
                                   Style="{StaticResource LabelTabla}"
                                   HorizontalOptions="StartAndExpand"/>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="4" Grid.Column="1" VerticalOptions="Start" Spacing="10" Margin="10,0,0,0">
            <Button Text="Eliminar Producto" TextColor="{StaticResource Main}"
                    IsEnabled="False"
                    Clicked="BtnEliminarSeleccionado_Clicked"
                    x:Name="BtnEliminarSeleccionado"
                    Style="{StaticResource Boton}"
                    BackgroundColor="{StaticResource Tier}"/>
            <Button Text="Confirmar Selección"
                    x:Name="BtnConfirmarSeleccion"
                    Clicked="BtnConfirmarSeleccion_Clicked"
                    Style="{StaticResource Boton}"
                    BackgroundColor="{StaticResource Sub}"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>