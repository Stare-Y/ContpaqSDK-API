<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="PedidosCPE.Views.SpinnerPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent">

    <Grid BackgroundColor="#80000000" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <Frame CornerRadius="10" Padding="20" HasShadow="True" BackgroundColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
                <ActivityIndicator IsRunning="True"
                                   Color="{StaticResource SubTier}"
                                   WidthRequest="69"
                                   HeightRequest="69"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>

                <Label Text="Procesando..."
                       TextColor="{StaticResource Tier}"
                       FontSize="Large"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</toolkit:Popup>
