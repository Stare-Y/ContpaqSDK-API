<toolkit:Popup
    x:Class="PedidosCPE.Views.Popups.GetUnidadesPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False"
    Color="Transparent">

    <Frame CornerRadius="10" Padding="0" HasShadow="True" BackgroundColor="{StaticResource White}">
        <Grid Padding="30" BackgroundColor="{StaticResource Main}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label x:Name="LblProductoName"
                   Grid.Row="0"
                   TextColor="{StaticResource Tier}"
                   FontSize="Large"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   WidthRequest="300"
                   Text="Unidades para: "/>

            <Entry x:Name="EntryUnidades"
                   Grid.Row="2"
                   TextChanged="EntryUnidades_TextChanged"
                   MinimumWidthRequest="150"
                   MaximumWidthRequest="500"
                   Placeholder="Ingrese unidades deseadas..."
                   PlaceholderColor="{StaticResource SubTier}"
                   TextColor="{StaticResource Black}"
                   BackgroundColor="{StaticResource Sub}"
                   FontSize="14"
                   HorizontalOptions="FillAndExpand"
                   Margin="0,10,0,10"/>

            <Label x:Name="LblError"
                   IsVisible="False"
                   Grid.Row="4"
                   TextColor="{StaticResource SubTier}"
                   FontSize="Small"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Margin="0,10,0,10"/>

            <StackLayout Grid.Row="6" Orientation="Horizontal" HorizontalOptions="Center" Spacing="20" Margin="0,10,0,10">
                <Button Text="Quitar"
                        Clicked="ButtonQuitar_Clicked"
                        BackgroundColor="{StaticResource SubTier}"
                        TextColor="{StaticResource White}"
                        CornerRadius="5"/>

                <Button Text="Aceptar"
                        Clicked="ButtonAceptar_Clicked"
                        BackgroundColor="{StaticResource SubTier}"
                        TextColor="{StaticResource White}"
                        CornerRadius="5"/>
            </StackLayout>
        </Grid>
    </Frame>
</toolkit:Popup>