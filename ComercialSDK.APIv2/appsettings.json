{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/applog-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "Properties": {
      "Application": "ComercialSDK.API"
    }
  },
  "AllowedHosts": "*",
  "ComercialSDKSettings": {
    "RutaBinarios": "C:\\Program Files (x86)\\Compac\\COMERCIAL",
    "NombrePAQ": "CONTPAQ I COMERCIAL",
    "RutaEmpresas": "C:\\Compac\\Empresas\\",
    "EmpresaDefault": "adCooperativa_2024",
    "User": "KEVIN",
    "Password": "index"
  }
}
