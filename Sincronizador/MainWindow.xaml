<Window x:Class="Sincronizador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sincronizador" xmlns:viewmodels="clr-namespace:Sincronizador.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:VMSincronizador}"
        mc:Ignorable="d"
        Title="Sincronizador de Compras" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition />
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1" >
            <StackPanel Orientation="Horizontal">
                <Label Content="Fecha de inicio:"/>
                <DatePicker Name="DateFechaInicio" SelectedDate="{Binding FechaInicio}"/> <!-- On conde behind, date is limited to yesterday-->
                <Label Content="Fecha fin:" />
                <DatePicker Name="DateFechaFin" SelectedDate="{Binding FechaFin}"/>
                <Label Content="Codigo del concepto a buscar:" />
                <TextBox Name="TxtSerie" Width="100" Text="{Binding Concepto}"/>
                <Button Name="BtnBuscar" Click="BtnBuscar_Click" Content="Buscar"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1" >
            <StackPanel Orientation="Horizontal">
                <ListView Name="PrimaryDocuments" ItemsSource="{Binding PrimaryDocumentos}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Serie" DisplayMemberBinding="{Binding CSERIEDOCUMENTO}"/>
                            <GridViewColumn Header="Folio" DisplayMemberBinding="{Binding CFOLIO}"/>
                            <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding CFECHA}"/>
                            <GridViewColumn Header="Total" DisplayMemberBinding="{Binding CRAZONSOCIAL}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <ListView Name="SecondaryDocuments" ItemsSource="{Binding SecondaryDocumentos}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Serie" DisplayMemberBinding="{Binding CSERIEDOCUMENTO}"/>
                            <GridViewColumn Header="Folio" DisplayMemberBinding="{Binding CFOLIO}"/>
                            <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding CFECHA}"/>
                            <GridViewColumn Header="Total" DisplayMemberBinding="{Binding CRAZONSOCIAL}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <ListView Name="FaltantesEnSecondary" ItemsSource="{Binding FaltantesEnSecondary}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Serie" DisplayMemberBinding="{Binding CSERIEDOCUMENTO}"/>
                            <GridViewColumn Header="Folio" DisplayMemberBinding="{Binding CFOLIO}"/>
                            <GridViewColumn Header="Fecha" DisplayMemberBinding="{Binding CFECHA}"/>
                            <GridViewColumn Header="Total" DisplayMemberBinding="{Binding CRAZONSOCIAL}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Border>

    </Grid>
</Window>
