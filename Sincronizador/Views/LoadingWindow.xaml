<Window x:Class="Sincronizador.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sincronizador.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Height="150" 
        Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Border BorderThickness="4" BorderBrush="DimGray">
            <Grid Background="White" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- Spinner -->
                <ProgressBar Grid.Row="0" IsIndeterminate="True" Width="380" Height="30"/>
                <TextBlock Grid.Row="1" Text="Buscando Documentos..." HorizontalAlignment="Center" Margin="5" FontSize="21"/>
            </Grid>
        </Border>
    </Grid>
</Window>
